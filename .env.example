# ---- Database (MySQL-compatible, e.g. TiDB Cloud) ----
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
DB_SSL=true

# ---- Login security: any long random text (40+ characters) ----
SESSION_SECRET=

# ---- Site ----
DELIVERY_FEE=150

# ---- Meal photo uploads (Vercel Blob; Vercel adds this token for you) ----
BLOB_READ_WRITE_TOKEN=

# ---- M-Pesa STK Push (leave blank to disable "Pay now with M-Pesa") ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline
MPESA_PARTYB=
MPESA_CALLBACK_BASE=https://your-project.vercel.app
MPESA_CALLBACK_SECRET=
